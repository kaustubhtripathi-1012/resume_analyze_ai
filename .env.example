# Root .env.example - Copy to .env and fill in values

# ---- Backend ----
PORT=5000
MONGODB_URI=mongodb://localhost:27017/resume_analyzer
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_KEY=your_nlp_service_key_here
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
NODE_ENV=development

# ---- NLP Service ----
SERVICE_KEY=your_nlp_service_key_here
SPACY_MODEL=en_core_web_md

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:5000
